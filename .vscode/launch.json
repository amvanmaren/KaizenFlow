{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Fullstack Debug",
            "configurations": [
                "Launch Frontend",
                "Launch Backend",
                "Launch Browser"
            ],
        }
    ],
    "configurations": [
        {
            "name": "Launch Backend",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "cwd": "${workspaceFolder}/backend/backend",
            "runtimeArgs": [
                "run",
                "start:dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true
        },
        {
            "name": "Launch Frontend",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "cwd": "${workspaceFolder}/frontend/KaizenFlow_Frontend",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true
        },
        {
            "name": "Launch Browser",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/KaizenFlow_Frontend/src/",
            "sourceMaps": true
        }
    ],
}